# ============================================================================
# Agentic AI Evaluator - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)
#
# Usage:
#   cp env.example .env
#   # Then edit .env with your actual values

# ============================================================================
# ENVIRONMENT & CORS (Phase 1 — production security)
# ============================================================================
# development | staging | production — affects CORS, health check error masking, API key bypass
ENVIRONMENT=development

# CORS allowed origins (comma-separated). In production only these origins are allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================================================
# API SECURITY (REQUIRED in production; optional in development for bypass)
# ============================================================================
# Generate a secure random string for API key
# You can use: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secure-api-key-here

# Optional: multiple keys (comma-separated). If set, validation accepts any of these keys.
# API_KEYS=key1,key2,key3

# Set to false to disable rate limiting (e.g. local dev or tests)
RATE_LIMIT_ENABLED=true

# ============================================================================
# AWS SECRETS MANAGER (OPTIONAL — production)
# ============================================================================
# Set to true to load missing env vars from AWS Secrets Manager (env wins; AWS fills only what's not set).
# USE_AWS_SECRETS=false
# AWS_SECRET_NAME=prod/agentic-evaluator/env
# AWS_REGION=ap-southeast-1
# When NOT using IAM role (e.g. local or non-AWS host), set credentials:
# AWS_ACCESS_KEY_ID=AKIA......................
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Template for the secret JSON: config/aws-secret-template.json
# Requires boto3 (in pyproject.toml). IAM role on EC2/ECS/Lambda = no keys needed.

# ============================================================================
# GOOGLE GEMINI API (REQUIRED)
# ============================================================================
GEMINI_APIKEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# Optional: For larger models
# GEMINI_LARGE=gemini-1.5-pro

# ============================================================================
# OPENROUTER API (REQUIRED for Chat Agent)
# ============================================================================
# Get your API key from: https://openrouter.ai/keys
# Free tier available with Llama 3.3 70B Instruct
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Model to use (default: free Llama 3.3 70B Instruct)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============================================================================
# GROQ API (OPTIONAL - Legacy, can be replaced with OpenRouter)
# ============================================================================
# Only needed if you want to use Groq instead of OpenRouter
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# ============================================================================
# QDRANT VECTOR DATABASE (REQUIRED)
# ============================================================================
# For local development:
# Qdrant_Localhost=http://localhost:6333
# QDRANT_API_KEY=  # Leave empty for local Qdrant

# For Qdrant Cloud:
Qdrant_Localhost=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here  # Get from Qdrant Cloud dashboard
Qdrant_Form=form_collection
Qdrant_Analysis_Report=analysis_collection

# ============================================================================
# EMBEDDING MODEL (REQUIRED)
# ============================================================================
# Recommended models:
# - BAAI/bge-small-en-v1.5 (default, fast, 384 dim)
# - sentence-transformers/all-MiniLM-L6-v2 (384 dim)
# - BAAI/bge-base-en-v1.5 (768 dim, better quality)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ============================================================================
# REDIS CONFIGURATION (REQUIRED)
# ============================================================================
# Option 1: Use full REDIS_URL (recommended for Railway, Redis Cloud)
# Railway provides this automatically - check Railway dashboard Variables tab
# REDIS_URL=redis://default:password@host:port/0

# Option 2: Use individual components
# For local development:
# REDIS_HOST=localhost
# REDIS_PORT=6380
# REDIS_PASSWORD=  # Leave empty for local Redis without password
#
# For Railway (if not using REDIS_URL):
# REDIS_HOST=redis.railway.internal
# REDIS_PORT=6379
# REDIS_USERNAME=default  # Railway uses "default" as username
# REDIS_PASSWORD=your-password
#
# For Render:
# REDIS_HOST=redis.render.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=  # Usually not required for Render
#
# For Redis Cloud:
# REDIS_HOST=redis-xxxxx.redis.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-password-here  # REQUIRED for Redis Cloud
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# CORS CONFIGURATION (OPTIONAL)
# ============================================================================
# Comma-separated list of allowed origins
# For local development:
CONNECTION_WEB=http://localhost:8501
# For production:
# CONNECTION_WEB=https://your-frontend-domain.com
# Multiple origins:
# CONNECTION_WEB=https://app1.com,https://app2.com
CONNECTION_MOBILE=

# ============================================================================
# LANGFUSE OBSERVABILITY (OPTIONAL)
# ============================================================================
# Get keys from: https://cloud.langfuse.com
# If not set, Langfuse will be disabled (app still works)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# LOGGING & DEBUG (OPTIONAL)
# ============================================================================
LOG_LEVEL=INFO
DEBUG=false

# ============================================================================
# FILE UPLOAD SETTINGS (OPTIONAL - has defaults)
# ============================================================================
MAX_FILE_SIZE_MB=50

# ============================================================================
# SEARCH SETTINGS (OPTIONAL - has defaults)
# ============================================================================
SEARCH_TOP_K=5
MAX_SEARCH_TOP_K=100
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
MIN_SEARCH_SCORE_THRESHOLD=0.75

# ============================================================================
# RETRY & TIMEOUT SETTINGS (OPTIONAL - has defaults)
# ============================================================================
# Maximum number of retry attempts for LLM API calls
# Default: 3 (will retry up to 3 times on failure)
MAX_RETRY_ATTEMPTS=3

# LLM timeout in seconds for each API call
# Default: 60 seconds
LLM_TIMEOUT_SECONDS=60

# Request timeout in seconds for general HTTP requests
# Default: 300 seconds (5 minutes)
REQUEST_TIMEOUT_SECONDS=300

# LLM Retry Backoff Settings (exponential backoff)
# Base delay in seconds (will be multiplied by 2^attempt)
# Default: 1.0 second
LLM_RETRY_BASE_DELAY=1.0

# Maximum delay in seconds (caps exponential backoff)
# Default: 10.0 seconds
LLM_RETRY_MAX_DELAY=10.0

# ============================================================================
# QUALITY THRESHOLDS (OPTIONAL - has defaults)
# ============================================================================
CONFIDENCE_GOOD=0.7
CONFIDENCE_ACCEPTABLE=0.4
GRAPH_CONFIDENCE_GOOD=0.7

# ============================================================================
# ARQ WORKER SETTINGS (OPTIONAL - has defaults)
# ============================================================================
ARQ_MAX_RETRIES=3
ARQ_RETRY_DELAY=5.0
# Reduce memory usage: ARQ automatically deletes job results after this time
ARQ_KEEP_RESULT_SECONDS=600  # 10 minutes - job results automatically deleted after 10 mins

# Limit concurrent jobs to save memory (fewer jobs = less memory used)
ARQ_MAX_JOBS=5  # Reduce from 10 to 5 to save memory (30MB free tier)

# ============================================================================
# CACHE SETTINGS (OPTIONAL - has defaults)
# ============================================================================
# Cache expires in 10 minutes if not saved to storage
# Cache is automatically deleted when saved to storage
CACHE_EXPIRY_MINUTES=10  # 10 minutes - cache expires if not saved

# ============================================================================
# POSTGRESQL CONFIGURATION (REQUIRED for Chat Agent Memory)
# ============================================================================
# Option 1: Use full POSTGRES_URL (recommended for Railway, Render, etc.)
# POSTGRES_URL=postgresql://user:password@host:port/database

# Option 2: Use individual components
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agentic_ai_evaluator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Connection Pool Settings (OPTIONAL - has defaults)
# Minimum number of connections to keep in pool
# Default: 2
POSTGRES_POOL_MIN=2

# Maximum number of connections in pool
# Default: 10 (adjust based on your load)
POSTGRES_POOL_MAX=10

# ============================================================================
# CHAT AGENT CONFIGURATION (OPTIONAL - has defaults)
# ============================================================================
# Maximum number of messages to use for conversation context
# Lower = less token usage, less context. Higher = more context, more tokens
# Default: 10 (5 conversation turns: user + assistant pairs)
MAX_CONTEXT_MESSAGES=10

# Maximum number of messages to load from PostgreSQL memory
# This prevents loading too many messages and hitting token limits
# Default: 10
MAX_MESSAGES_TO_LOAD=10

# Agent Cache Configuration
# Maximum number of cached agents (LRU cache)
# Default: 50
MAX_CACHE_SIZE=50

# Cache TTL in hours - how long to keep agents in cache
# Default: 24 hours
CACHE_TTL_HOURS=24

# Session Timeout Configuration
# Session expires after this many minutes of inactivity (no user messages)
# Default: 30 minutes (session auto-expires if user doesn't send message for 30 mins)
SESSION_TIMEOUT_MINUTES=30

# Auto-cleanup expired sessions older than this many days
# Default: 7 days (sessions older than 7 days are automatically cleaned up)
SESSION_CLEANUP_DAYS=7

# ============================================================================
# GUNICORN SETTINGS (OPTIONAL - for production)
# ============================================================================
# Railway/Render auto-sets PORT, but you can override:
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=300
# GUNICORN_LOG_LEVEL=info

